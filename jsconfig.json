{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"],
      "src/*": ["frontend/src/*"]
    }
  },
  "include": [
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "backend",
    "dist"
  ]
}
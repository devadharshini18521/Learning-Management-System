# ================================
# Cross-platform line endings
# ================================

* text=auto eol=lf

# ================================
# Source code files
# ================================
*.js   text eol=lf
*.ts   text eol=lf
*.jsx  text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env  text eol=lf

# ================================
# Shell scripts (Linux/macOS)
# ================================
*.sh   text eol=lf

# ================================
# Windows scripts
# ================================
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ================================
# Binary files (do NOT touch)
# ================================
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.exe  binary
*.woff binary
*.woff2 binary
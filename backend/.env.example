# ===========================================
# Zoho LMS Backend Environment Variables
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/zoho-lms

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Resend Email API Key (get from https://resend.com)
# 1. Sign up at resend.com
# 2. Go to API Keys section
# 3. Create a new API key
# 4. Copy the key here (starts with re_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email From Address
# Use onboarding@resend.dev for testing, or verify a custom domain
EMAIL_FROM=onboarding@resend.dev

# Frontend URL (for generating reset links)
FRONTEND_URL=http://localhost:5173

# ===========================================
# EMAIL SETUP INSTRUCTIONS:
# ===========================================

# For Development/Testing:
# 1. Go to https://resend.com and sign up
# 2. Navigate to API Keys in the dashboard
# 3. Click "Create API Key"
# 4. Copy the key (starts with re_)
# 5. Paste it above as RESEND_API_KEY
# 6. Restart the backend server

# For Production:
# 1. Verify your domain in Resend
# 2. Update EMAIL_FROM to use your verified domain
# 3. Update FRONTEND_URL to your production frontend URL

# ===========================================

